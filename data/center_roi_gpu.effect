uniform float4x4 ViewProj;
sampler2D image;

uniform float4 image_size;
uniform float4 roi_size;
uniform float4 roi_center;
uniform float4 box_color;
uniform float  box_width;

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData DefaultVS(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

float4 PSNormal(VertData v_in) : TARGET
{
    float2 pixel_pos = v_in.uv * image_size.xy;
    float4 color = tex2D(image, v_in.uv);

    float2 box_min = roi_center.xy - roi_size.xy * 0.5;
    float2 box_max = roi_center.xy + roi_size.xy * 0.5;

    float on_left   = step(abs(pixel_pos.x - box_min.x), box_width)
                      * step(box_min.y, pixel_pos.y) * step(pixel_pos.y, box_max.y);

    float on_right  = step(abs(pixel_pos.x - box_max.x), box_width)
                      * step(box_min.y, pixel_pos.y) * step(pixel_pos.y, box_max.y);

    float on_top    = step(abs(pixel_pos.y - box_min.y), box_width)
                      * step(box_min.x, pixel_pos.x) * step(pixel_pos.x, box_max.x);

    float on_bottom = step(abs(pixel_pos.y - box_max.y), box_width)
                      * step(box_min.x, pixel_pos.x) * step(pixel_pos.x, box_max.x);

    float is_edge = saturate(on_left + on_right + on_top + on_bottom);

    return lerp(color, box_color, is_edge);
}

float4 PSROI(VertData v_in) : TARGET
{
    float2 pixel_pos = v_in.uv * image_size.xy;

    float2 box_min = roi_center.xy - roi_size.xy * 0.5;
    float2 box_max = roi_center.xy + roi_size.xy * 0.5;

    float in_roi = step(box_min.x, pixel_pos.x) * step(pixel_pos.x, box_max.x)
                 * step(box_min.y, pixel_pos.y) * step(pixel_pos.y, box_max.y);

    float4 color = tex2D(image, v_in.uv);

    return lerp(float4(0,0,0,1), color, in_roi);
}

technique NormalRender
{
    pass
    {
        vertex_shader = DefaultVS(ViewProj);
        pixel_shader  = PSNormal;
    }
}

technique ROIRender
{
    pass
    {
        vertex_shader = DefaultVS(ViewProj);
        pixel_shader  = PSROI;
    }
}
