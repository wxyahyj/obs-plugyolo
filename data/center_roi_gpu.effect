// -------------------------------------------------------------------------
// OBS GPU Filter Shader - Center ROI GPU
// 功能：处理 RGBA 纹理，绘制红色框，提取中心 ROI
// -------------------------------------------------------------------------

// 输入纹理：RGBA 格式
sampler2D image : register(s0);

// -------------------------------------------------------------------------
// Uniform 参数（从 C 代码传入）
// -------------------------------------------------------------------------

// 画面尺寸 (width, height, 1.0/width, 1.0/height)
uniform float4 image_size;

// ROI 尺寸 (roi_width, roi_height, 0, 0)
uniform float4 roi_size;

// ROI 中心坐标 (center_x, center_y, 0, 0)
uniform float4 roi_center;

// 红色框颜色 (r, g, b, a) - 红色
uniform float4 box_color = {1.0, 0.0, 0.0, 1.0};

// 红色框线宽（像素）
uniform float box_width = 1.0;

// -------------------------------------------------------------------------
// 顶点着色器 - 使用 OBS 默认顶点着色器
// -------------------------------------------------------------------------

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData mainVS(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

// -------------------------------------------------------------------------
// 像素着色器 - 正常渲染 + 绘制红色框
// 功能：渲染 RGBA 纹理，并在画面中央绘制红色线框
// -------------------------------------------------------------------------

float4 PSNormal(VertData input) : TARGET
{
	// 获取当前像素坐标（像素空间）
	float2 pixel_pos = input.uv * image_size.xy;

	// 采样 RGBA 纹理
	float4 color = tex2D(image, input.uv);

	// -------------------------------------------------------------------------
	// 计算红色框区域
	// 框的中心是 roi_center，尺寸是 roi_size
	// 框的左上角：roi_center - roi_size / 2
	// 框的右下角：roi_center + roi_size / 2
	// -------------------------------------------------------------------------

	float2 box_min = roi_center.xy - roi_size.xy * 0.5;
	float2 box_max = roi_center.xy + roi_size.xy * 0.5;

	// 判断当前像素是否在红色框的边缘
	bool on_left_edge = (abs(pixel_pos.x - box_min.x) < box_width) &&
	                    (pixel_pos.y >= box_min.y && pixel_pos.y <= box_max.y);
	bool on_right_edge = (abs(pixel_pos.x - box_max.x) < box_width) &&
	                     (pixel_pos.y >= box_min.y && pixel_pos.y <= box_max.y);
	bool on_top_edge = (abs(pixel_pos.y - box_min.y) < box_width) &&
	                   (pixel_pos.x >= box_min.x && pixel_pos.x <= box_max.x);
	bool on_bottom_edge = (abs(pixel_pos.y - box_max.y) < box_width) &&
	                      (pixel_pos.x >= box_min.x && pixel_pos.x <= box_max.x);

	// 如果在框的边缘，使用红色
	if (on_left_edge || on_right_edge || on_top_edge || on_bottom_edge) {
		return box_color;
	}

	// 否则返回原始颜色
	return color;
}

// -------------------------------------------------------------------------
// 像素着色器 - 只输出中心 ROI
// 功能：只渲染中心 ROI 区域，其余区域为黑色
// -------------------------------------------------------------------------

float4 PSROI(VertData input) : TARGET
{
	// 获取当前像素坐标（像素空间）
	float2 pixel_pos = input.uv * image_size.xy;

	// 计算 ROI 边界
	float2 box_min = roi_center.xy - roi_size.xy * 0.5;
	float2 box_max = roi_center.xy + roi_size.xy * 0.5;

	// 判断当前像素是否在 ROI 区域内
	bool in_roi = (pixel_pos.x >= box_min.x && pixel_pos.x <= box_max.x) &&
	              (pixel_pos.y >= box_min.y && pixel_pos.y <= box_max.y);

	// 如果不在 ROI 区域内，返回黑色
	if (!in_roi) {
		return float4(0.0, 0.0, 0.0, 1.0);
	}

	// 在 ROI 区域内，返回原始颜色
	return tex2D(image, input.uv);
}

// -------------------------------------------------------------------------
// Technique：正常渲染 + 绘制红色框
// 使用场景：输出到 OBS 显示，用户可以看到带红框的画面
// -------------------------------------------------------------------------
technique NormalRender
{
	pass
	{
		vertex_shader = mainVS(input);
		pixel_shader = PSNormal(input);
	}
}

// -------------------------------------------------------------------------
// Technique：只输出中心 ROI
// 使用场景：提取 ROI 数据用于 YOLO 推理
// -------------------------------------------------------------------------
technique ROIRender
{
	pass
	{
		vertex_shader = mainVS(input);
		pixel_shader = PSROI(input);
	}
}