// -------------------------------------------------------------------------
// 核心 Uniform 参数
// -------------------------------------------------------------------------

// OBS 必须的变换矩阵，名字必须是 ViewProj，否则报错
uniform float4x4 ViewProj;

// 输入纹理
uniform texture2d image;

// 画面尺寸 (width, height, 1.0/width, 1.0/height)
uniform float4 image_size;

// ROI 尺寸和中心 (注意：OBS 传入 float2 即可，用 float4 也可以，但逻辑要对)
uniform float4 roi_size;
uniform float4 roi_center;

// 红色框属性
uniform float4 box_color = {1.0, 0.0, 0.0, 1.0};
uniform float box_width = 1.0;

// -------------------------------------------------------------------------
// 采样器定义 (必须明确定义，不能只写名字)
// -------------------------------------------------------------------------
sampler_state LinearClamp {
    Filter    = Linear;
    AddressU  = Clamp;
    AddressV  = Clamp;
};

// -------------------------------------------------------------------------
// 结构体
// -------------------------------------------------------------------------
struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// -------------------------------------------------------------------------
// 顶点着色器
// -------------------------------------------------------------------------
VertData DefaultVS(VertData v_in)
{
    VertData v_out;
    // 必须使用 mul(..., ViewProj)
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// -------------------------------------------------------------------------
// 像素着色器 1 - 正常渲染 + 绘制红色框
// -------------------------------------------------------------------------
float4 PSNormal(VertData v_in) : TARGET
{
    float2 pixel_pos = v_in.uv * image_size.xy;
    float4 color = image.Sample(LinearClamp, v_in.uv);

    float2 box_min = roi_center.xy - roi_size.xy * 0.5;
    float2 box_max = roi_center.xy + roi_size.xy * 0.5;

    // 简化的边缘判断
    bool on_left_edge = (abs(pixel_pos.x - box_min.x) < box_width) && (pixel_pos.y >= box_min.y && pixel_pos.y <= box_max.y);
    bool on_right_edge = (abs(pixel_pos.x - box_max.x) < box_width) && (pixel_pos.y >= box_min.y && pixel_pos.y <= box_max.y);
    bool on_top_edge = (abs(pixel_pos.y - box_min.y) < box_width) && (pixel_pos.x >= box_min.x && pixel_pos.x <= box_max.x);
    bool on_bottom_edge = (abs(pixel_pos.y - box_max.y) < box_width) && (pixel_pos.x >= box_min.x && pixel_pos.x <= box_max.x);

    if (on_left_edge || on_right_edge || on_top_edge || on_bottom_edge) {
        return box_color;
    }

    return color;
}

// -------------------------------------------------------------------------
// 像素着色器 2 - 只输出 ROI (其余黑色)
// -------------------------------------------------------------------------
float4 PSROI(VertData v_in) : TARGET
{
    float2 pixel_pos = v_in.uv * image_size.xy;
    float2 box_min = roi_center.xy - roi_size.xy * 0.5;
    float2 box_max = roi_center.xy + roi_size.xy * 0.5;

    bool in_roi = (pixel_pos.x >= box_min.x && pixel_pos.x <= box_max.x) &&
                  (pixel_pos.y >= box_min.y && pixel_pos.y <= box_max.y);

    if (!in_roi) {
        return float4(0.0, 0.0, 0.0, 1.0);
    }

    return image.Sample(LinearClamp, v_in.uv);
}

// -------------------------------------------------------------------------
// Technique 修正 (注意这里的 v_in 参数名必须对应)
// -------------------------------------------------------------------------
technique NormalRender
{
    pass
    {
        vertex_shader = DefaultVS(v_in);
        pixel_shader  = PSNormal(v_in);
    }
}

technique ROIRender
{
    pass
    {
        vertex_shader = DefaultVS(v_in);
        pixel_shader  = PSROI(v_in);
    }
}