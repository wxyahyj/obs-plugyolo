// -------------------------------------------------------------------------
// OBS GPU Filter Shader - Center ROI GPU
// 功能：处理 RGBA 纹理，绘制红色框，提取中心 ROI
// -------------------------------------------------------------------------

// 输入纹理
sampler2D image;

// -------------------------------------------------------------------------
// Uniform 参数（从 C 代码传入）
// -------------------------------------------------------------------------

// 画面尺寸 (width, height, 1.0/width, 1.0/height)
uniform float4 image_size;

// ROI 尺寸 (roi_width, roi_height, 0, 0)
uniform float4 roi_size;

// ROI 中心坐标 (center_x, center_y, 0, 0)
uniform float4 roi_center;

// 红色框颜色 (r, g, b, a) - 红色
uniform float4 box_color;

// 红色框线宽（像素）
uniform float box_width;

// -------------------------------------------------------------------------
// 结构体
// -------------------------------------------------------------------------
struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// -------------------------------------------------------------------------
// 顶点着色器 - 使用 OBS 默认顶点着色器
// -------------------------------------------------------------------------
VertData DefaultVS(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// -------------------------------------------------------------------------
// 像素着色器 - 正常渲染 + 绘制红色框
// 功能：渲染 RGBA 纹理，并在画面中央绘制红色线框
// -------------------------------------------------------------------------
float4 PSNormal(VertData v_in) : TARGET
{
    // 获取当前像素坐标（像素空间）
    float2 pixel_pos = v_in.uv * image_size.xy;

    // 采样 RGBA 纹理
    float4 color = tex2D(image, v_in.uv);

    // -------------------------------------------------------------------------
    // 计算红色框区域
    // 框的中心是 roi_center，尺寸是 roi_size
    // 框的左上角：roi_center - roi_size / 2
    // 框的右下角：roi_center + roi_size / 2
    // -------------------------------------------------------------------------

    float2 box_min = roi_center.xy - roi_size.xy * 0.5;
    float2 box_max = roi_center.xy + roi_size.xy * 0.5;

    // 使用 step 函数替代 bool，实现边缘检测
    float on_left_edge = step(abs(pixel_pos.x - box_min.x) - box_width, 0.0) * 
                         step(box_min.y - pixel_pos.y, 0.0) * 
                         step(pixel_pos.y - box_max.y, 0.0);
    float on_right_edge = step(abs(pixel_pos.x - box_max.x) - box_width, 0.0) * 
                          step(box_min.y - pixel_pos.y, 0.0) * 
                          step(pixel_pos.y - box_max.y, 0.0);
    float on_top_edge = step(abs(pixel_pos.y - box_min.y) - box_width, 0.0) * 
                        step(box_min.x - pixel_pos.x, 0.0) * 
                        step(pixel_pos.x - box_max.x, 0.0);
    float on_bottom_edge = step(abs(pixel_pos.y - box_max.y) - box_width, 0.0) * 
                           step(box_min.x - pixel_pos.x, 0.0) * 
                           step(pixel_pos.x - box_max.x, 0.0);

    // 如果在框的边缘，使用红色，否则返回原始颜色
    float4 edge_mask = float4(on_left_edge + on_right_edge + on_top_edge + on_bottom_edge, 
                              on_left_edge + on_right_edge + on_top_edge + on_bottom_edge, 
                              on_left_edge + on_right_edge + on_top_edge + on_bottom_edge, 
                              on_left_edge + on_right_edge + on_top_edge + on_bottom_edge);
    edge_mask = saturate(edge_mask); // 确保值在 [0,1] 范围内
    
    return lerp(color, box_color, edge_mask.r);
}

// -------------------------------------------------------------------------
// 像素着色器 - 只输出中心 ROI
// 功能：只渲染中心 ROI 区域，其余区域为黑色
// -------------------------------------------------------------------------
float4 PSROI(VertData v_in) : TARGET
{
    // 获取当前像素坐标（像素空间）
    float2 pixel_pos = v_in.uv * image_size.xy;

    // 计算 ROI 边界
    float2 box_min = roi_center.xy - roi_size.xy * 0.5;
    float2 box_max = roi_center.xy + roi_size.xy * 0.5;

    // 使用 step 函数判断当前像素是否在 ROI 区域内
    float in_roi = step(box_min.x - pixel_pos.x, 0.0) * 
                   step(pixel_pos.x - box_max.x, 0.0) * 
                   step(box_min.y - pixel_pos.y, 0.0) * 
                   step(pixel_pos.y - box_max.y, 0.0);

    // 在 ROI 区域内返回原始颜色，否则返回黑色
    float4 roi_color = tex2D(image, v_in.uv);
    float4 black = float4(0.0, 0.0, 0.0, 1.0);
    
    return lerp(black, roi_color, in_roi);
}

// -------------------------------------------------------------------------
// Technique：正常渲染 + 绘制红色框
// 使用场景：输出到 OBS 显示，用户可以看到带红框的画面
// -------------------------------------------------------------------------
technique NormalRender
{
    pass
    {
        vertex_shader = DefaultVS(ViewProj);
        pixel_shader  = PSNormal;
    }
}

// -------------------------------------------------------------------------
// Technique：只输出中心 ROI
// 使用场景：提取 ROI 数据用于 YOLO 推理
// -------------------------------------------------------------------------
technique ROIRender
{
    pass
    {
        vertex_shader = DefaultVS(ViewProj);
        pixel_shader  = PSROI;
    }
}